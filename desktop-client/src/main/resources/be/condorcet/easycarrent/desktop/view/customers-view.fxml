<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
	xmlns:fx="http://javafx.com/fxml"
	fx:controller="be.condorcet.easycarrent.desktop.view.CustomerController"
	spacing="14.0" styleClass="customer-view">
	<padding>
		<Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
	</padding>
	<children>
		<HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="customer-header">
			<children>
				<VBox spacing="2.0">
					<children>
						<Label text="Customers" styleClass="customer-editor-title"/>
						<Label text="Manage the customers who can rent vehicles."
							styleClass="customer-status"/>
					</children>
				</VBox>
				<Region HBox.hgrow="ALWAYS"/>
				<Label fx:id="readOnlyNoticeLabel"
					text="Read-only: your role cannot modify customers."
					visible="false" managed="false" styleClass="read-only-notice"/>
				<ProgressIndicator fx:id="loadingIndicator" maxWidth="26.0" maxHeight="26.0"
					visible="false" styleClass="customer-loading"/>
			</children>
		</HBox>

		<HBox spacing="10.0" styleClass="customer-toolbar">
			<children>
				<Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"
					styleClass="secondary-button"/>
				<Button fx:id="addButton" text="Add Customer" onAction="#handleAdd"
					styleClass="primary-button"/>
				<Button fx:id="editButton" text="Edit" onAction="#handleEdit"
					styleClass="secondary-button"/>
				<Button fx:id="deleteButton" text="Delete" onAction="#handleDelete"
					styleClass="danger-button"/>
			</children>
		</HBox>

		<Label fx:id="statusMessageLabel" wrapText="true" visible="false" managed="false"
			styleClass="customer-status"/>

		<TableView fx:id="customerTable" VBox.vgrow="ALWAYS" styleClass="customer-table">
			<columns>
				<TableColumn fx:id="idColumn" text="ID" prefWidth="60.0"/>
				<TableColumn fx:id="firstNameColumn" text="First name" prefWidth="120.0"/>
				<TableColumn fx:id="lastNameColumn" text="Last name" prefWidth="120.0"/>
				<TableColumn fx:id="emailColumn" text="Email" prefWidth="200.0"/>
				<TableColumn fx:id="phoneColumn" text="Phone" prefWidth="130.0"/>
				<TableColumn fx:id="drivingLicenseColumn" text="Licence" prefWidth="130.0"/>
			</columns>
		</TableView>

		<Label fx:id="emptyStateLabel" text="No customers yet."
			visible="false" managed="false" styleClass="customer-empty-state"/>

		<VBox fx:id="customerEditor" spacing="10.0" visible="false" managed="false"
			styleClass="customer-editor">
			<children>
				<Label fx:id="formTitleLabel" text="Add Customer" styleClass="customer-editor-title"/>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="First name" minWidth="130.0" styleClass="form-label"/>
						<TextField fx:id="firstNameField" HBox.hgrow="ALWAYS"
							styleClass="customer-form-field"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Last name" minWidth="130.0" styleClass="form-label"/>
						<TextField fx:id="lastNameField" HBox.hgrow="ALWAYS"
							styleClass="customer-form-field"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Email" minWidth="130.0" styleClass="form-label"/>
						<TextField fx:id="emailField" HBox.hgrow="ALWAYS"
							styleClass="customer-form-field"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Phone" minWidth="130.0" styleClass="form-label"/>
						<TextField fx:id="phoneField" HBox.hgrow="ALWAYS"
							styleClass="customer-form-field"/>
					</children>
				</HBox>
				<HBox spacing="10.0" styleClass="form-row">
					<children>
						<Label text="Address" minWidth="130.0" styleClass="form-label"/>
						<TextArea fx:id="addressArea" prefRowCount="2" wrapText="true"
							HBox.hgrow="ALWAYS" styleClass="customer-form-field"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Licence number" minWidth="130.0" styleClass="form-label"/>
						<TextField fx:id="drivingLicenseField" HBox.hgrow="ALWAYS"
							styleClass="customer-form-field"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Licence expiry" minWidth="130.0" styleClass="form-label"/>
						<DatePicker fx:id="drivingLicenseExpiryPicker" styleClass="customer-form-field"/>
					</children>
				</HBox>
				<Label fx:id="validationMessageLabel" wrapText="true"
					visible="false" managed="false" styleClass="customer-validation-message"/>
				<HBox spacing="10.0">
					<children>
						<Button fx:id="saveButton" text="Save" onAction="#handleSave"
							styleClass="primary-button"/>
						<Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel"
							styleClass="secondary-button"/>
					</children>
				</HBox>
			</children>
		</VBox>
	</children>
</VBox>
