<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
	xmlns:fx="http://javafx.com/fxml"
	fx:controller="be.condorcet.easycarrent.desktop.view.DashboardController"
	fitToWidth="true" styleClass="dashboard-view">
	<content>
		<VBox spacing="16.0">
			<padding>
				<Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
			</padding>
			<children>
				<HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="dashboard-header">
					<children>
						<VBox spacing="2.0">
							<children>
								<Label text="Dashboard" styleClass="dashboard-section-title"/>
								<Label text="A read-only overview of the current operational data."
									styleClass="dashboard-status-message"/>
							</children>
						</VBox>
						<Region HBox.hgrow="ALWAYS"/>
						<ProgressIndicator fx:id="loadingIndicator" maxWidth="26.0" maxHeight="26.0"
							visible="false" styleClass="dashboard-loading"/>
						<Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"
							styleClass="secondary-button"/>
					</children>
				</HBox>

				<Label fx:id="lastUpdatedLabel" text="" styleClass="dashboard-last-updated"/>
				<Label fx:id="statusMessageLabel" text="" wrapText="true" visible="false" managed="false"
					styleClass="dashboard-status-message"/>
				<Label fx:id="unavailableLabel" text="Dashboard data is currently unavailable."
					wrapText="true" visible="false" managed="false" styleClass="dashboard-unavailable"/>

				<VBox fx:id="dashboardContent" spacing="16.0">
					<children>
						<FlowPane hgap="12.0" vgap="12.0" styleClass="dashboard-metric-grid">
							<children>
								<VBox spacing="4.0" styleClass="dashboard-metric-card">
									<children>
										<Label text="Vehicle categories" styleClass="dashboard-metric-title"/>
										<Label fx:id="vehicleCategoryCountLabel" text="—"
											styleClass="dashboard-metric-value"/>
									</children>
								</VBox>
								<VBox spacing="4.0" styleClass="dashboard-metric-card">
									<children>
										<Label text="Vehicles" styleClass="dashboard-metric-title"/>
										<Label fx:id="vehicleCountLabel" text="—"
											styleClass="dashboard-metric-value"/>
									</children>
								</VBox>
								<VBox spacing="4.0" styleClass="dashboard-metric-card">
									<children>
										<Label text="Available vehicles" styleClass="dashboard-metric-title"/>
										<Label fx:id="availableVehicleCountLabel" text="—"
											styleClass="dashboard-metric-value"/>
									</children>
								</VBox>
								<VBox spacing="4.0" styleClass="dashboard-metric-card">
									<children>
										<Label text="Customers" styleClass="dashboard-metric-title"/>
										<Label fx:id="customerCountLabel" text="—"
											styleClass="dashboard-metric-value"/>
									</children>
								</VBox>
								<VBox spacing="4.0" styleClass="dashboard-metric-card">
									<children>
										<Label text="Active rentals" styleClass="dashboard-metric-title"/>
										<Label fx:id="activeRentalCountLabel" text="—"
											styleClass="dashboard-metric-value"/>
									</children>
								</VBox>
								<VBox spacing="4.0" styleClass="dashboard-metric-card">
									<children>
										<Label text="Pending payments" styleClass="dashboard-metric-title"/>
										<Label fx:id="pendingPaymentCountLabel" text="—"
											styleClass="dashboard-metric-value"/>
									</children>
								</VBox>
								<VBox spacing="4.0" styleClass="dashboard-metric-card">
									<children>
										<Label text="Maintenance in progress"
											styleClass="dashboard-metric-title"/>
										<Label fx:id="maintenanceInProgressCountLabel" text="—"
											styleClass="dashboard-metric-value"/>
									</children>
								</VBox>
							</children>
						</FlowPane>

						<VBox spacing="6.0" styleClass="dashboard-section">
							<children>
								<Label text="Vehicles by status" styleClass="dashboard-section-title"/>
								<FlowPane fx:id="vehicleStatusContainer" hgap="10.0" vgap="6.0"
									styleClass="dashboard-status-grid"/>
							</children>
						</VBox>

						<VBox spacing="6.0" styleClass="dashboard-section">
							<children>
								<Label text="Rentals by status" styleClass="dashboard-section-title"/>
								<FlowPane fx:id="rentalStatusContainer" hgap="10.0" vgap="6.0"
									styleClass="dashboard-status-grid"/>
							</children>
						</VBox>

						<VBox spacing="6.0" styleClass="dashboard-section">
							<children>
								<Label text="Payments by status" styleClass="dashboard-section-title"/>
								<FlowPane fx:id="paymentStatusContainer" hgap="10.0" vgap="6.0"
									styleClass="dashboard-status-grid"/>
							</children>
						</VBox>

						<VBox spacing="6.0" styleClass="dashboard-section">
							<children>
								<Label text="Maintenance by status" styleClass="dashboard-section-title"/>
								<FlowPane fx:id="maintenanceStatusContainer" hgap="10.0" vgap="6.0"
									styleClass="dashboard-status-grid"/>
							</children>
						</VBox>

						<VBox spacing="6.0" styleClass="dashboard-section">
							<children>
								<Label text="Payment amounts" styleClass="dashboard-section-title"/>
								<HBox spacing="8.0" styleClass="dashboard-payment-total">
									<children>
										<Label text="Paid" minWidth="90.0" styleClass="dashboard-status-name"/>
										<Label fx:id="paidPaymentAmountLabel" text="—"
											styleClass="dashboard-status-value"/>
									</children>
								</HBox>
								<HBox spacing="8.0" styleClass="dashboard-payment-total">
									<children>
										<Label text="Pending" minWidth="90.0"
											styleClass="dashboard-status-name"/>
										<Label fx:id="pendingPaymentAmountLabel" text="—"
											styleClass="dashboard-status-value"/>
									</children>
								</HBox>
								<HBox spacing="8.0" styleClass="dashboard-payment-total">
									<children>
										<Label text="Refunded" minWidth="90.0"
											styleClass="dashboard-status-name"/>
										<Label fx:id="refundedPaymentAmountLabel" text="—"
											styleClass="dashboard-status-value"/>
									</children>
								</HBox>
							</children>
						</VBox>
					</children>
				</VBox>
			</children>
		</VBox>
	</content>
</ScrollPane>
