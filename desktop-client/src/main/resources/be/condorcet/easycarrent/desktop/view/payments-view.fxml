<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
	xmlns:fx="http://javafx.com/fxml"
	fx:controller="be.condorcet.easycarrent.desktop.view.PaymentController"
	spacing="14.0" styleClass="payment-view">
	<padding>
		<Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
	</padding>
	<children>
		<HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="payment-header">
			<children>
				<VBox spacing="2.0">
					<children>
						<Label text="Payments" styleClass="payment-editor-title"/>
						<Label text="Record and manage the payment for each active or completed rental."
							styleClass="payment-status-message"/>
					</children>
				</VBox>
				<Region HBox.hgrow="ALWAYS"/>
				<Label fx:id="readOnlyNoticeLabel"
					text="Read-only: your role cannot modify payments."
					visible="false" managed="false" styleClass="payment-read-only-notice"/>
				<ProgressIndicator fx:id="loadingIndicator" maxWidth="26.0" maxHeight="26.0"
					visible="false" styleClass="payment-loading"/>
			</children>
		</HBox>

		<HBox spacing="10.0" styleClass="payment-toolbar">
			<children>
				<Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"
					styleClass="secondary-button"/>
				<Button fx:id="addButton" text="Add Payment" onAction="#handleAdd"
					styleClass="primary-button"/>
				<Button fx:id="markPaidButton" text="Mark paid" onAction="#handleMarkPaid"
					styleClass="secondary-button"/>
				<Button fx:id="markFailedButton" text="Mark failed" onAction="#handleMarkFailed"
					styleClass="secondary-button"/>
				<Button fx:id="retryButton" text="Retry" onAction="#handleRetry"
					styleClass="secondary-button"/>
				<Button fx:id="refundButton" text="Refund" onAction="#handleRefund"
					styleClass="secondary-button"/>
				<Button fx:id="deleteButton" text="Delete" onAction="#handleDelete"
					styleClass="danger-button"/>
			</children>
		</HBox>

		<Label fx:id="statusMessageLabel" wrapText="true" visible="false" managed="false"
			styleClass="payment-status-message"/>

		<TableView fx:id="paymentTable" VBox.vgrow="ALWAYS" styleClass="payment-table">
			<columns>
				<TableColumn fx:id="idColumn" text="ID" prefWidth="55.0"/>
				<TableColumn fx:id="rentalColumn" text="Rental" prefWidth="220.0"/>
				<TableColumn fx:id="amountColumn" text="Amount" prefWidth="100.0"
					styleClass="payment-amount-column"/>
				<TableColumn fx:id="methodColumn" text="Method" prefWidth="110.0"/>
				<TableColumn fx:id="statusColumn" text="Status" prefWidth="100.0"/>
				<TableColumn fx:id="createdAtColumn" text="Created" prefWidth="140.0"/>
				<TableColumn fx:id="paidAtColumn" text="Paid" prefWidth="140.0"/>
			</columns>
		</TableView>

		<Label fx:id="emptyStateLabel" text="No payments yet."
			visible="false" managed="false" styleClass="payment-empty-state"/>

		<VBox fx:id="paymentEditor" spacing="10.0" visible="false" managed="false"
			styleClass="payment-editor">
			<children>
				<Label fx:id="formTitleLabel" text="Add Payment" styleClass="payment-editor-title"/>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Rental" minWidth="130.0" styleClass="form-label"/>
						<ComboBox fx:id="rentalComboBox" HBox.hgrow="ALWAYS"
							styleClass="payment-form-field"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Payment method" minWidth="130.0" styleClass="form-label"/>
						<ComboBox fx:id="paymentMethodComboBox" HBox.hgrow="ALWAYS"
							styleClass="payment-form-field"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Amount" minWidth="130.0" styleClass="form-label"/>
						<Label fx:id="amountPreviewLabel" text="—" styleClass="payment-state-label"/>
					</children>
				</HBox>
				<Label text="The backend derives the amount from the rental total and sets the status."
					styleClass="payment-amount-note"/>
				<VBox fx:id="formMessagesContainer" spacing="4.0"
					visible="false" managed="false" styleClass="payment-validation-messages"/>
				<HBox spacing="10.0">
					<children>
						<Button fx:id="saveButton" text="Save" onAction="#handleSave"
							styleClass="primary-button"/>
						<Button fx:id="cancelEditButton" text="Cancel" onAction="#handleCancelEdit"
							styleClass="secondary-button"/>
					</children>
				</HBox>
			</children>
		</VBox>
	</children>
</VBox>
