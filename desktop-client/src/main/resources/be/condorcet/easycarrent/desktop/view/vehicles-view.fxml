<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
	xmlns:fx="http://javafx.com/fxml"
	fx:controller="be.condorcet.easycarrent.desktop.view.VehicleController"
	spacing="14.0" styleClass="vehicle-view">
	<padding>
		<Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
	</padding>
	<children>
		<HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="vehicle-header">
			<children>
				<VBox spacing="2.0">
					<children>
						<Label text="Vehicles" styleClass="vehicle-editor-title"/>
						<Label text="Manage the rental fleet. Status is managed by the backend."
							styleClass="vehicle-status"/>
					</children>
				</VBox>
				<Region HBox.hgrow="ALWAYS"/>
				<Label fx:id="readOnlyNoticeLabel"
					text="Read-only: your role cannot modify vehicles."
					visible="false" managed="false" styleClass="read-only-notice"/>
				<ProgressIndicator fx:id="loadingIndicator" maxWidth="26.0" maxHeight="26.0"
					visible="false" styleClass="vehicle-loading"/>
			</children>
		</HBox>

		<HBox spacing="10.0" styleClass="vehicle-toolbar">
			<children>
				<Button fx:id="refreshButton" text="Refresh" onAction="#handleRefresh"
					styleClass="secondary-button"/>
				<Button fx:id="addButton" text="Add Vehicle" onAction="#handleAdd"
					styleClass="primary-button"/>
				<Button fx:id="editButton" text="Edit" onAction="#handleEdit"
					styleClass="secondary-button"/>
				<Button fx:id="deleteButton" text="Delete" onAction="#handleDelete"
					styleClass="danger-button"/>
			</children>
		</HBox>

		<Label fx:id="statusMessageLabel" wrapText="true" visible="false" managed="false"
			styleClass="vehicle-status"/>

		<TableView fx:id="vehicleTable" VBox.vgrow="ALWAYS" styleClass="vehicle-table">
			<columns>
				<TableColumn fx:id="idColumn" text="ID" prefWidth="60.0"/>
				<TableColumn fx:id="registrationColumn" text="Registration" prefWidth="120.0"/>
				<TableColumn fx:id="brandColumn" text="Brand" prefWidth="110.0"/>
				<TableColumn fx:id="modelColumn" text="Model" prefWidth="110.0"/>
				<TableColumn fx:id="yearColumn" text="Year" prefWidth="70.0"/>
				<TableColumn fx:id="categoryColumn" text="Category" prefWidth="130.0"/>
				<TableColumn fx:id="statusColumn" text="Status" prefWidth="110.0"/>
				<TableColumn fx:id="dailyRateColumn" text="Daily Price" prefWidth="100.0"/>
			</columns>
		</TableView>

		<Label fx:id="emptyStateLabel" text="No vehicles yet."
			visible="false" managed="false" styleClass="vehicle-empty-state"/>

		<VBox fx:id="vehicleEditor" spacing="10.0" visible="false" managed="false"
			styleClass="vehicle-editor">
			<children>
				<Label fx:id="formTitleLabel" text="Add Vehicle" styleClass="vehicle-editor-title"/>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Registration" minWidth="110.0" styleClass="form-label"/>
						<TextField fx:id="registrationField" HBox.hgrow="ALWAYS"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Brand" minWidth="110.0" styleClass="form-label"/>
						<TextField fx:id="brandField" HBox.hgrow="ALWAYS"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Model" minWidth="110.0" styleClass="form-label"/>
						<TextField fx:id="modelField" HBox.hgrow="ALWAYS"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Year" minWidth="110.0" styleClass="form-label"/>
						<TextField fx:id="manufacturingYearField" HBox.hgrow="ALWAYS"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Color" minWidth="110.0" styleClass="form-label"/>
						<TextField fx:id="colorField" HBox.hgrow="ALWAYS"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Daily Price" minWidth="110.0" styleClass="form-label"/>
						<TextField fx:id="dailyRateField" HBox.hgrow="ALWAYS"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Mileage" minWidth="110.0" styleClass="form-label"/>
						<TextField fx:id="mileageField" HBox.hgrow="ALWAYS"/>
					</children>
				</HBox>
				<HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="form-row">
					<children>
						<Label text="Category" minWidth="110.0" styleClass="form-label"/>
						<ComboBox fx:id="categoryComboBox" HBox.hgrow="ALWAYS"
							styleClass="vehicle-category-field"/>
					</children>
				</HBox>
				<Label fx:id="validationMessageLabel" wrapText="true"
					visible="false" managed="false" styleClass="validation-message"/>
				<HBox spacing="10.0">
					<children>
						<Button fx:id="saveButton" text="Save" onAction="#handleSave"
							styleClass="primary-button"/>
						<Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel"
							styleClass="secondary-button"/>
					</children>
				</HBox>
			</children>
		</VBox>
	</children>
</VBox>
