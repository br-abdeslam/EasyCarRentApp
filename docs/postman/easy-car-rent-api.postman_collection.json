        {
          "name": "Delete vehicle",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}", "host": ["{{baseUrl}}"], "path": ["api", "vehicles", "{{vehicleId}}"] }
          }
        }
      ]
    },
